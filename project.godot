;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CIN-Express"
run/main_scene="uid://il0r1gff85a6"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/fullsize=false
boot_splash/image="uid://yeg07ptac1dm"
config/icon="res://icon.svg"
boot_splash/minimum_display_time=3000

[autoload]

GameManager="*res://scenes/game_manager.tscn"
SaveManager="*res://scenes/save_manager.tscn"
PlayerManager="*res://scenes/player_manager.tscn"
AudioManager="*res://scenes/audio_manager.tscn"
CharacterManager="*res://scenes/character_manager.tscn"

