func gerar_nome(genero: int, tamanho_nome: int) -> String:
	if tamanho_nome <= 0:
		return ""
	
	var primeiro_nome: String
	var segundo_nome: String
	
	var nome_completo: String
	
	if genero == CharacterManager.HOMEM:
		primeiro_nome = nomes_masculinos.pick_random() 
		segundo_nome = nomes_masculinos.pick_random()
		
	else:
		primeiro_nome = nomes_femininos.pick_random()
		segundo_nome = nomes_femininos.pick_random()
	
	nome_completo = primeiro_nome
	
	var tem_segundo_nome: bool = [true, false].pick_random()
	if tem_segundo_nome and tamanho_nome > 1:
		nome_completo += (" " + segundo_nome)
	var nr_de_sobrenomes_a_gerar = tamanho_nome - len(nome_completo.split(" "))
	print("Numero de sobrenomes a gerar: ", nr_de_sobrenomes_a_gerar)
	var i = nr_de_sobrenomes_a_gerar;
	var tentativas = 20
	while i > 0:
		var gerar_composto: bool = [true, false, false, false, false].pick_random()
		var candidato: String = sobrenomes_compostos.pick_random() if gerar_composto else sobrenomes.pick_random()
		print("Candidato: ",candidato)
		if candidato.is_subsequence_of(nome_completo):
			tentativas -= 1
			if tentativas <= 0:
				break;

			continue;
		
		nome_completo += (" " + candidato)
		i -= 1
	
	return nome_completo	
	
